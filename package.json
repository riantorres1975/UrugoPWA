{
  "name": "rutas-uruapan",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:admin-integration": "playwright test --config=playwright.admin.config.ts",
    "api-key:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-community-api-key.mjs",
    "landmarks:review": "node scripts/generate-landmarks.mjs",
    "landmarks:apply": "node scripts/generate-landmarks.mjs --apply && node scripts/generate-landmark-index.mjs",
    "landmarks:index": "node scripts/generate-landmark-index.mjs",
    "db:seed-routes": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-routes-to-supabase.mjs",
    "guide:screenshots": "node scripts/capture-guide-screenshots.mjs",
    "readme:assets": "node scripts/capture-guide-screenshots.mjs && node scripts/capture-report-demo.mjs",
    "video:record": "node scripts/record-demo-video.mjs",
    "video:studio": "remotion studio video/index.ts",
    "video:render:wide": "remotion render video/index.ts UruGoDemoWide video/out/urugo-demo-horizontal.mp4 --codec=h264 --crf=18",
    "video:render:vertical": "remotion render video/index.ts UruGoDemoVertical video/out/urugo-demo-vertical.mp4 --codec=h264 --crf=18",
    "video:render": "pnpm video:render:wide && pnpm video:render:vertical",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm bundle:check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.509",
    "@remotion/media": "^4.0.509",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright-core": "^1.62.1",
    "postcss": "8.5.26",
    "remotion": "^4.0.509",
    "tailwindcss": "3.4.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
