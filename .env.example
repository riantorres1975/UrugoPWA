# Token PÚBLICO de Mapbox (se expone al cliente por diseño).
# IMPORTANTE: restríngelo por dominio (URL referrer) en el dashboard de Mapbox
# para que nadie pueda reutilizarlo desde otro sitio y consumir tu cuota.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.tu_token_publico_mapbox
# Production URL used in share links. Defaults to the Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL=https://rutasuruapanpwa.vercel.app
DEEPSEEK_API_KEY=sk-tu_token_deepseek

# Rate limiting durable y global entre instancias serverless (opcional pero
# recomendado en producción). Sin estas vars, el rate limit cae a memoria por
# instancia. Crea una base gratuita en https://upstash.com (Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alertas operativas para errores criticos del cliente. El endpoint debe usar
# HTTPS; el token Bearer es opcional. Las alertas no incluyen mensajes, stacks
# ni ubicacion del usuario. Se deduplican por huella y tienen un limite global.
ERROR_ALERT_WEBHOOK_URL=
ERROR_ALERT_WEBHOOK_TOKEN=

# Optional local-only route editor. Do not enable in public production unless protected.
DEBUG_ROUTE_SAVE_ENABLED=false
DEBUG_ROUTE_SAVE_TOKEN=usa_un_token_largo_si_activas_el_editor

# Supabase: reportes comunitarios, historial de rutas y panel administrativo.
# La publishable key puede usarse para la sesión; la secret key NUNCA se expone.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Correos que pueden entrar al panel. Sepáralos con comas. También pueden
# autorizarse usuarios insertándolos en public.admin_members.
ADMIN_EMAILS=tu-correo@ejemplo.com

# Resumen diario de reportes y señales pendientes. Vercel envía CRON_SECRET
# automáticamente como Bearer; el remitente debe estar verificado en Resend.
CRON_SECRET=
RESEND_API_KEY=
ADMIN_NOTIFICATION_FROM="UruGo <avisos@auth.urugo.app>"
# Opcional: si queda vacío, el resumen se envía a ADMIN_EMAILS.
ADMIN_NOTIFICATION_EMAILS=

# Destino de los enlaces mágicos del panel. Déjalo en producción para que un
# correo solicitado desde localhost también abra el panel publicado.
ADMIN_AUTH_REDIRECT_URL=https://www.urugo.app/auth/callback

# Se usa para anonimizar IPs en reportes. Genera al menos 32 bytes aleatorios.
REPORTER_HASH_SECRET=

# Empieza en static. Cambia a supabase solo después de ejecutar db:seed-routes.
ROUTE_DATA_SOURCE=static

# Formas de apoyo. Estos datos se muestran públicamente; no agregues contraseñas.
# PayPal usa el enlace actual si SUPPORT_PAYPAL_URL queda vacío.
# Mercado Pago y SPEI sólo aparecen en /apoyar cuando sus datos son válidos.
SUPPORT_MERCADOPAGO_URL=
SUPPORT_PAYPAL_URL=https://www.paypal.com/paypalme/wh0code
SUPPORT_SPEI_CLABE=
SUPPORT_SPEI_RECIPIENT=
SUPPORT_SPEI_BANK=
